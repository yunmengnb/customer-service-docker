# 忆梦云团队开发
ADMIN_PORT=5174
USER_PORT=5175
CLIENT_PORT=5176

# 单节点副本集默认启用；已初始化后不得随意改名
MONGO_REPLICA_SET=kf-rs0

JWT_SECRET=请替换为随机长字符串
CORS_ORIGIN=http://服务器IP:5174,http://服务器IP:5175,http://服务器IP:5176
# 管理端危险写操作仅接受此 HTTPS origin；多个明确来源用逗号分隔，禁止 *
ADMIN_PUBLIC_ORIGIN=https://管理端域名
CLIENT_PUBLIC_URL=http://服务器IP:5176

DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=请设置至少8位强密码
DEFAULT_ADMIN_EMAIL=admin@example.com

DEFAULT_TENANT_NAME=默认企业
DEFAULT_TENANT_USERNAME=demo
DEFAULT_TENANT_PASSWORD=请设置至少8位强密码

# 管理页面允许超级管理员启停；它不会绕过下面的数据面、活动指针和主密钥安全检查
MIGRATION_FEATURE_AVAILABLE=false
# 真实迁移与活动指针默认关闭。仅在完成备份和演练后显式改为 true，并设置独立随机 MIGRATION_MASTER_KEY
MIGRATION_DATA_PLANE_ENABLED=false
MIGRATION_ACTIVE_POINTER_ENABLED=false
MIGRATION_MASTER_KEY=
