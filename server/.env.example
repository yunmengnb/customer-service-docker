# 忆梦云团队开发
PORT=3000
NODE_ENV=development

# 应用版本（可在部署时覆盖版本配置）
APP_VERSION=1.0.0
APP_EDITION=特别版

# MongoDB 业务连接
MONGO_URI=mongodb://localhost:27017/customer_service?replicaSet=kf-rs0&authSource=admin&directConnection=true

# 管理页面许可仅允许超级管理员持久启停管理功能，不代表可执行真实迁移
MIGRATION_FEATURE_AVAILABLE=false
# 数据面与活动指针相互独立：仅启用数据面时最多执行 staging dry-run
# control DB 必须与业务数据库分离；真实切换还须显式设置独立主密钥、INSTANCE_REPLICA_COUNT=1 和受控重启模式
# 活动数据库指针与真实切换默认关闭；仅在完成双站演练后显式启用
MIGRATION_ACTIVE_POINTER_ENABLED=false
MIGRATION_CONTROL_URI=mongodb://localhost:27017/customer_service_control?replicaSet=kf-rs0&authSource=admin&directConnection=true
MIGRATION_CONTROL_DB=customer_service_control
MIGRATION_MASTER_KEY=
MIGRATION_RESTART_MODE=none
MIGRATION_RESTART_EXIT_CODE=75
MIGRATION_INSTANCE_ID=
INSTANCE_REPLICA_COUNT=1
MIGRATION_EXIT_DELAY_MS=1000
MIGRATION_DATA_PLANE_ENABLED=false
# staging 位于 uploads 命名卷内的隐藏目录，以保证目录切换为同文件系统原子 rename；不得映射为静态资源
MIGRATION_STAGING_DIR=/app/uploads/.migration-private/staging
MIGRATION_BACKUP_DIR=/app/migration-backup
MIGRATION_TEMP_DIR=/app/migration-temp

# Redis（可选；留空时自动降级为单进程内存实现）
REDIS_URL=
REDIS_CONNECT_TIMEOUT_MS=2000
REDIS_CACHE_TTL_SECONDS=300

# JWT 密钥（生产环境必须更换为随机长字符串）
JWT_SECRET=change_me_to_a_long_random_string_for_production
JWT_EXPIRES_IN=7d

# CORS 允许的来源（逗号分隔）
CORS_ORIGIN=http://localhost:5174,http://localhost:5175,http://localhost:5176
# 管理端危险写操作的明确 HTTPS origin allowlist；禁止 *
ADMIN_PUBLIC_ORIGIN=https://admin.example.com

# 默认管理员账号（安装前必须设置安全密码）
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_EMAIL=admin@example.com

# 默认租户（可选；如需初始化，请设置安全密码）
DEFAULT_TENANT_NAME=示例企业
DEFAULT_TENANT_USERNAME=demo
DEFAULT_TENANT_PASSWORD=
